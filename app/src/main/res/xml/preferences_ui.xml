<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_ui">

    <org.oxycblt.auxio.settings.ui.IntListPreference
        app:defaultValue="@integer/theme_auto"
        app:entries="@array/entries_theme"
        app:entryIcons="@array/icons_theme"
        app:entryValues="@array/values_theme"
        app:icon="@drawable/ic_light_24"
        app:key="@string/set_key_theme"
        app:title="@string/set_theme" />

    <org.oxycblt.auxio.settings.ui.WrappedDialogPreference
        app:icon="@drawable/ic_accent_dynamic_24"
        app:key="@string/set_key_accent"
        app:title="@string/set_accent" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/set_key_black_theme"
        app:summary="@string/set_black_mode_desc"
        app:title="@string/set_black_mode" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="@string/set_key_round_mode"
        app:summary="@string/set_round_mode_desc"
        app:title="@string/set_round_mode" />


    <PreferenceCategory
        app:title="@string/set_glass_background_group"
        app:summary="@string/set_glass_background_desc">

        <ListPreference
            app:key="@string/set_key_glass_background_style"
            app:title="@string/set_glass_background_style"
            app:summary="@string/set_glass_background_style_desc"
            app:defaultValue="preset"
            app:entries="@array/entries_glass_background_style"
            app:entryValues="@array/values_glass_background_style" />

        <ListPreference
            app:key="@string/set_key_glass_background_preset"
            app:title="@string/set_glass_background_preset"
            app:summary="@string/set_glass_background_preset_desc"
            app:defaultValue="aurora"
            app:entries="@array/entries_glass_background_preset"
            app:entryValues="@array/values_glass_background_preset" />

        <Preference
            app:key="@string/set_key_glass_background_color_one"
            app:title="@string/set_glass_background_color_one"
            app:summary="@string/set_glass_background_color_summary"
            app:persistent="false" />

        <Preference
            app:key="@string/set_key_glass_background_color_two"
            app:title="@string/set_glass_background_color_two"
            app:summary="@string/set_glass_background_color_summary"
            app:persistent="false" />

        <Preference
            app:key="@string/set_key_glass_background_color_three"
            app:title="@string/set_glass_background_color_three"
            app:summary="@string/set_glass_background_color_summary"
            app:persistent="false" />

        <Preference
            app:key="@string/set_key_glass_background_solid_color"
            app:title="@string/set_glass_background_solid_color"
            app:summary="@string/set_glass_background_color_summary"
            app:persistent="false" />

        <Preference
            app:key="@string/set_key_glass_background_image"
            app:title="@string/set_glass_background_image"
            app:summary="@string/set_glass_background_image_none"
            app:persistent="false" />

        <SeekBarPreference
            app:key="@string/set_key_glass_background_blur"
            app:title="@string/set_glass_background_blur"
            app:summary="@string/set_glass_background_blur_desc"
            app:defaultValue="28"
            app:min="0"
            android:max="48"
            app:seekBarIncrement="4"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            app:key="@string/set_key_glass_background_darkness"
            app:title="@string/set_glass_background_darkness"
            app:summary="@string/set_glass_background_darkness_desc"
            app:defaultValue="35"
            app:min="0"
            android:max="70"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true" />

    </PreferenceCategory>
</PreferenceScreen>