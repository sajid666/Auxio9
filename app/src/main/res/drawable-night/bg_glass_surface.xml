<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#60FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#32FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="#00FFFFFF" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
